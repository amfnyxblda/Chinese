---
import BaseLayout from "../layouts/BaseLayout.astro";
import RemoteMessageForm from "../components/RemoteMessageForm.astro";

const baseUrl = Astro.site?.toString() ?? Astro.url.origin;
const pageUrl = Astro.url.href;
const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Hubungi - Jagapet",
  description: "Hubungi Jagapet untuk soalan, cadangan atau kerjasama",
  url: pageUrl,
  isPartOf: {
    "@type": "WebSite",
    name: "Jagapet",
    url: baseUrl,
  },
  about: {
    "@type": "Organization",
    name: "Jagapet",
    url: baseUrl,
  },
};
---

<BaseLayout
  title="Hubungi"
  description="Hantarkan mesej kepada kami dan kami akan menghubungi anda semula."
>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
  <section class="contact-page">
    <div class="container contact-page__inner">
      <span class="contact-page__kicker">Hubungi kami</span>
      <h1 class="contact-page__title">Hubungi</h1>
      <p class="contact-page__desc">
        Ada soalan, cadangan atau idea kerjasama? Hantarkan nota kepada kami.
      </p>

      <RemoteMessageForm
        title="Hantar Mesej"
        intro="Gunakan borang di bawah dan kami akan membalas secepat mungkin."
        submitLabel="Hantar Mesej"
        source="contact-page"
        successMessage="Berjaya. Mesej anda telah diterima."
      />
    </div>
  </section>
</BaseLayout>

<style>
.contact-page {
  padding-top: calc(var(--nav-height) + var(--space-xl));
  padding-bottom: var(--space-3xl);
}

.contact-page__inner {
  max-width: 860px;
}

.contact-page__kicker {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: var(--space-sm);
}

.contact-page__title {
  margin: 0 0 var(--space-sm);
  font-size: clamp(2rem, 5vw, 3rem);
}

.contact-page__desc {
  margin: 0;
  max-width: 640px;
  color: var(--color-ink-3);
  line-height: 1.7;
}
</style>
