---
import { formatCategory } from "../lib/utils";

interface Props {
  categories: string[];
  searchHref: string;
  categoryHref: (category: string) => string;
}

const { categories, searchHref, categoryHref } = Astro.props;
---

<aside class="blog-sidebar">
  <div class="sidebar-section">
    <h3 class="sidebar-heading">类别</h3>
    <ul class="sidebar-cats">
      {categories.map((cat) => (
        <li>
          <a href={categoryHref(cat)} class="sidebar-cat">
            <span class="sidebar-cat__name">{formatCategory(cat)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="sidebar-section">
    <a href={searchHref} class="sidebar-search-link">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
      搜寻文章
    </a>
  </div>
</aside>
